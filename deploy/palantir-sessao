#!/bin/sh
# Prepara o ambiente e abre o Cage com o Chromium. Chamado pela unit da sessão.
set -eu

# Usa o teclado escolhido na instalação do Debian (ABNT2, por exemplo).
if [ -r /etc/default/keyboard ]; then
	. /etc/default/keyboard
	export XKB_DEFAULT_MODEL="${XKBMODEL:-}" XKB_DEFAULT_LAYOUT="${XKBLAYOUT:-}"
	export XKB_DEFAULT_VARIANT="${XKBVARIANT:-}" XKB_DEFAULT_OPTIONS="${XKBOPTIONS:-}"
fi
if [ -r /etc/palantir/quiosque.env ]; then
	set -a
	. /etc/palantir/quiosque.env
	set +a
fi

# -s permite trocar de console (Ctrl+Alt+F2); -d dispensa decorações de janela.
exec /usr/bin/cage -s -d -- "$(dirname "$(readlink -f "$0")")/palantir-quiosque"
