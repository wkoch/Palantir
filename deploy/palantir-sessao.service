[Unit]
Description=Sessão do Palantír no tty1 (Cage e Chromium em kiosk)
Documentation=https://github.com/wkoch/Palantir
After=systemd-user-sessions.service plymouth-quit-wait.service user@@UID@.service
Wants=dbus.socket user@@UID@.service
# O tty1 é da sessão gráfica; o tty2 continua como console de emergência.
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=@USUARIO@
WorkingDirectory=~
PAMName=palantir-sessao
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStartPre=+/usr/bin/chvt 1
ExecStart=/opt/palantir/atual/palantir-sessao
# Se o Cage ou o Chromium terminarem, a sessão volta sozinha.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
