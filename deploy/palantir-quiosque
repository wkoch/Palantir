#!/bin/sh
# Espera o daemon responder e abre o Chromium em kiosk na interface local.
set -eu

URL="${PALANTIR_URL:-http://127.0.0.1:7700}"
ESCALA="${PALANTIR_ESCALA:-1.25}"
# Idioma dos controles do próprio Chromium (seletor de arquivos, leitor de PDF).
export LANGUAGE="${PALANTIR_IDIOMA:-pt_BR}"
PERFIL="${XDG_DATA_HOME:-$HOME/.local/share}/palantir-chromium"

# A escala é aplicada pelo compositor. A opção --force-device-scale-factor do
# Chromium desenha a janela pela metade no Wayland.
if command -v wlr-randr >/dev/null 2>&1; then
	for saida in $(wlr-randr | awk '/^[^ ]/ {print $1}'); do
		wlr-randr --output "$saida" --scale "$ESCALA" || echo "não foi possível aplicar a escala em $saida" >&2
	done
fi

until curl --silent --fail --max-time 2 "$URL/api/saude" >/dev/null 2>&1; do
	sleep 0.5
done

# Sem expansão de curingas nas opções extras.
set -f

# Perfil dedicado, sem sincronização, extensões ou senhas salvas. As políticas
# em /etc/chromium/policies restringem a navegação à origem local.
exec /usr/bin/chromium \
	--kiosk \
	--ozone-platform=wayland \
	--user-data-dir="$PERFIL" \
	--no-first-run \
	--no-default-browser-check \
	--noerrdialogs \
	--disable-session-crashed-bubble \
	--disable-component-update \
	--disable-background-networking \
	--disable-sync \
	--disable-features=Translate,MediaRouter \
	--password-store=basic \
	--lang=pt-BR \
	${PALANTIR_CHROMIUM_EXTRA:-} \
	"${PALANTIR_PAGINA:-$URL/}"
